            {/* Dropdown Menu */}
            <div className="absolute left-0 top-full hidden group-hover:grid grid-cols-2 gap-6 bg-white text-gray-800 shadow-2xl rounded-md p-6 w-[520px] transition-all duration-200 z-50">
              <div>
                <h4 className="text-xs font-bold uppercase tracking-wider text-[#215B87] border-b border-gray-200 pb-2 mb-3">
