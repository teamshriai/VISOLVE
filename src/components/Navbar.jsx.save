                </h4>
                <ul className="space-y-2 text-xs">
                  <li><a href="#migration" className="hover:text-[#215B87] transition-colors">Migration Service</a></li>
                  <li><a href="#performance" className="hover:text-[#215B87] transition-colors">Performance Tools</a></li>
                  <li><a href="#cloud" className="hover:text-[#215B87] transition-colors">Cloud Services</a></li>
                  <li><a href="#qa" className="hover:text-[#215B87] transition-colors">Product/Solution QA Certification</a></li>
                  <li><a href="#virtualization" className="hover:text-[#215B87] transition-colors">Virtualization Services</a></li>
                  <li><a href="#opensource" className="hover:text-[#215B87] transition-colors">OpenSource Services</a></li>
                  <li><a href="#security" className="hover:text-[#215B87] transition-colors">Enterprise Security (2FA, SSO)</a></li>
                  <li><a href="#demo-portals" className="hover:text-[#215B87] transition-colors">Solution Demo Portals</a></li>
                </ul>
              </div>
              <div>
                <h4 className="text-xs font-bold uppercase tracking-wider text-[#215B87] border-b border-gray-200 pb-2 mb-3">
                  Healthcare IT Services
                </h4>
                <ul className="space-y-2 text-xs">
                 <li>
  <Link to="/services/emr" className="hover:text-[#215B87] transition-colors">
    OpenEMR Customization
  </Link>
</li>
 <li><a href="#openemr" className="hover:text-[#215B87] transition-colors">OpenEMR Customization</a></li>
                  <li><a href="#interoperability" className="hover:text-[#215B87] transition-colors">Interoperability Services</a></li>
                  <li><a href="#hosting" className="hover:text-[#215B87] transition-colors">Cloud Hosting</a></li>
                  <li><a href="#support" className="hover:text-[#215B87] transition-colors">Support</a></li>
                  <li><a href="#meaningfuluse" className="hover:text-[#215B87] transition-colors">Meaningful Use Objective</a></li>
                </ul>
              </div>
            </div>
          </div>

          {/* Products Dropdown */}
          <div className="relative group">
            <button className="px-3 py-2 rounded-md inline-flex items-center space-x-1 hover:text-[#FFA500] transition-colors">
