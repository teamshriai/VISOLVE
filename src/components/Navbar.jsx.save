                <path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" />
              </svg>
            </button>
            <div className="absolute left-0 top-full hidden group-hover:block bg-white text-gray-800 shadow-xl rounded-md p-4 w-56 transition-all duration-200 z-50">
              <ul className="space-y-2 text-xs">
                <li><a href="#openemr-pro" className="hover:text-[#215B87] transition-colors block">OpenEMR Pro</a></li>
                <li><a href="#patient-portal" className="hover:text-[#215B87] transition-colors block">Patient Portal</a></li>
                <li><a href="#billing" className="hover:text-[#215B87] transition-colors block">Billing</a></li>
                <li><a href="#2fa" className="hover:text-[#215B87] transition-colors block">2FA</a></li>
                <li><a href="#calendar" className="hover:text-[#215B87] transition-colors block">Google Calendar Integration</a></li>
                <li><a href="#scheduler" className="hover:text-[#215B87] transition-colors block">Scheduler</a></li>
                <li><a href="#eprescription" className="hover:text-[#215B87] transition-colors block">e-Prescription</a></li>
                <li><a href="#telehealth" className="hover:text-[#215B87] transition-colors block">Telehealth - Video Consulting</a></li>
              </ul>
            </div>
          </div>

          {/* Resources Dropdown */}
          <div className="relative group">
            <button className="px-3 py-2 rounded-md inline-flex items-center space-x-1 hover:text-[#FFA500] transition-colors">
              <span>Resources</span>
              <svg className="w-4 h-4 fill-current ml-1" viewBox="0 0 20 20">
                <path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" />
              </svg>
            </button>
            <div className="absolute left-0 top-full hidden group-hover:block bg-white text-gray-800 shadow-xl rounded-md p-4 w-48 transition-all duration-200 z-50">
              <ul className="space-y-2 text-xs">
